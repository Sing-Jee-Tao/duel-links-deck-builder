{
  "name": "duel-links-deck-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Deck Ledger — a Yu-Gi-Oh! Duel Links deck builder that solves the strongest legal deck out of a player's collection.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "fetch:cards": "tsx scripts/fetch-cards.ts",
    "scrape:banlist": "tsx scripts/scrape-banlist.ts",
    "scrape:banlist:snapshot": "tsx scripts/scrape-banlist.ts --snapshot",
    "fetch:fonts": "tsx scripts/fetch-fonts.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.45.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
